# Copie este arquivo para ".env" (na mesma pasta do script) e preencha.
# Não coloque aspas nos valores. No Windows, prefira barras normais no caminho:
#   CSV_DIR=C:/Users/seu_usuario/Documents/multas_ibama

# Pasta onde estão os CSVs multas_ambientais_distribuidas_por_bens_tutelados_<UF>.csv
CSV_DIR=/caminho/para/a/pasta/dos/csvs

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=sua_senha

# Schema de destino da camada bronze
DB_SCHEMA=sch_bronze

# --- Opcionais (deixe vazio para detectar automaticamente) ---
# Separador do CSV, ex.: ;
CSV_SEP=
# Encoding do CSV, ex.: utf-8 ou latin-1
CSV_ENCODING=
# Linhas lidas por vez (padrão 50000)
CHUNK_SIZE=
